---
import Thumb from "./Thumb.astro";
import { isDoreArtwork } from "../lib/artworks";
import {
  getArtworkTitle,
} from "../lib/directus";

interface Props {
  work: any;
  index?: number;
  basePath?: string;
}

const { work, index = 99, basePath = "/oeuvres" } = Astro.props;
const src = work.media.thumb;
const title = getArtworkTitle(work);
const artistName =
  work.artist && typeof work.artist === "object" ? work.artist.name : null;
const href = `${basePath}/${work.slug}`;
---

<article class="artwork-card catalog-card group">
  <Thumb
    href={href}
    src={src}
    alt={title}
    loading={index < 8 ? "eager" : "lazy"}
    fetchpriority={index < 8 ? "high" : "low"}
    zoom={Boolean(src)}
    data-lightbox
    data-epic={String(isDoreArtwork(work))}
    data-alt={title}
    data-href={href}
    data-preview={work.media.preview}
    data-dzi={work.media.dzi}
  />
  <a href={href} class="catalog-card-copy">
    <h2>{title}</h2>
    {(artistName || work.year) && (
      <p>{[artistName, work.year].filter(Boolean).join(" · ")}</p>
    )}
  </a>
</article>
