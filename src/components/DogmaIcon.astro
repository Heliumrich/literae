  caution: 'M12 3 2 21h20ZM12 9v5m0 3v1',
  nuance: 'M12 3v18m-5 0h10M3 7h18M6 7l-4 8h8ZM18 7l-4 8h8Z',
  defender: 'M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6ZM7 12l3 3 7-7',
