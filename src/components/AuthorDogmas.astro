---
import { micromark } from 'micromark';
import { dogmaBand, dogmaLabels, dogmaGroups, type Dogma } from '../lib/dogmas';
import DogmaIcon from './DogmaIcon.astro';
interface Props { points: Dogma[]; author: string }
const { points, author } = Astro.props;
const groups = dogmaGroups(points);
---
{groups.length > 0 && <aside class="author-dogmas" aria-label={`Repères doctrinaux – ${author}`}>
  <p class="dogma-heading">Repères doctrinaux</p>
  {groups.map(group => <div class:list={['dogma-row', group.tone, { 'has-negative': group.points.some(point => point.grade < 0) }]}>
    <span class="dogma-row-label">{group.label}</span>
    <ul>
      {group.points.map(point => {
        const band = dogmaBand(point.grade);
        const id = `dogma-${point.id}`;
        return <li class:list={['dogma-item', band]} style={`--dogma-strength:${Math.abs(point.grade) * 10}%`}>
          <button type="button" class="dogma-trigger" popovertarget={id} aria-controls={id} aria-expanded="false"
            aria-label={`${point.title} : ${dogmaLabels[band]}`}>
            <DogmaIcon band={band} /><span>{point.title}</span>
          </button>
          <div id={id} class="dogma-popover" popover="auto" role="dialog" aria-labelledby={`${id}-title`}>
            <header><h3 id={`${id}-title`}>{point.title}</h3><button class="dogma-close" type="button" popovertarget={id} popovertargetaction="hide" aria-label="Fermer">×</button></header>
            <p class="dogma-level"><DogmaIcon band={band} />{dogmaLabels[band]} <strong>{Math.abs(point.grade)}</strong></p>
            {point.description && <div class="rich-text dogma-description" set:html={micromark(point.description)} />}
            {point.url && <a class="dogma-source" href={point.url} target="_blank" rel="noopener noreferrer">En savoir plus <span aria-hidden="true">↗</span><span class="sr-only"> (nouvel onglet)</span></a>}
          </div>
        </li>;
      })}
    </ul>
  </div>)}
</aside>}
<script>
  import { initDogmaPopovers } from '../lib/dogmas-client';
  initDogmaPopovers();
</script>
<style>
  .author-dogmas {
    --dogma-red-soft: #a85c40; --dogma-red-strong: #a11f35;
    --dogma-green-soft: #59713b; --dogma-green-strong: #17603c; --dogma-amber: #80601f;
    margin-top: 1.25rem; padding-block: .65rem; border-block: 1px solid var(--border);
    font-family: var(--type-ui);
  }
  :global([data-theme="dark"]) .author-dogmas {
    --dogma-red-soft: #e9aa7f; --dogma-red-strong: #ff7f8e;
    --dogma-green-soft: #b6ca86; --dogma-green-strong: #6cdda7; --dogma-amber: #e3c57e;
  }
  .dogma-heading { color: var(--text-subtle); font-size: .58rem; text-transform: uppercase; letter-spacing: .1em; margin-bottom: .5rem; }
  .dogma-row { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .7rem; padding-left: .6rem; border-left: 2px solid var(--border); }
  .dogma-row + .dogma-row { margin-top: .4rem; }
  .dogma-row.positive { border-left-color: var(--dogma-green-strong); }
  .dogma-row.vigilance { border-left-color: var(--dogma-amber); }
  .dogma-row.has-negative { border-left-color: var(--dogma-red-strong); }
  .dogma-row-label { color: var(--text-muted); font-size: .6rem; }
  ul { display: flex; flex-wrap: wrap; gap: .35rem; list-style: none; padding: 0; margin: 0; min-width: 0; }
  .dogma-item { --dogma-tone: var(--dogma-amber); min-width: 0; }
  .danger, .caution { --dogma-tone: color-mix(in srgb, var(--dogma-red-strong) var(--dogma-strength), var(--dogma-red-soft)); }
  .defender, .exemplary { --dogma-tone: color-mix(in srgb, var(--dogma-green-strong) var(--dogma-strength), var(--dogma-green-soft)); }
  .dogma-trigger { display: inline-flex; align-items: center; gap: .4rem; min-height: 2.25rem; max-width: 100%; padding: .3rem .5rem; border: 1px solid color-mix(in srgb, var(--dogma-tone) 40%, var(--border)); border-radius: 3px; background: color-mix(in srgb, var(--dogma-tone) 6%, var(--bg)); color: var(--text); font-size: .7rem; text-align: left; cursor: pointer; }
  .dogma-trigger span { overflow-wrap: anywhere; }
  .dogma-level strong, .dogma-trigger :global(svg), .dogma-level :global(svg) { color: var(--dogma-tone); flex-shrink: 0; }
  .dogma-level strong { font-size: .8rem; font-variant-numeric: tabular-nums; }
  .dogma-trigger:hover, .dogma-trigger[aria-expanded="true"] { border-color: var(--dogma-tone); }
  .dogma-trigger:focus-visible, .dogma-close:focus-visible { outline: 2px solid var(--dogma-tone); outline-offset: 3px; }
  .dogma-popover { position: fixed; inset: auto; margin: 0; width: min(25rem, calc(100vw - 2rem)); max-height: min(65dvh, 32rem); overflow-y: auto; overscroll-behavior: contain; padding: 1rem; border: 1px solid color-mix(in srgb, var(--dogma-tone) 55%, var(--border)); border-radius: 4px; background: var(--card); color: var(--text); box-shadow: 0 .5rem 2rem #0003; font-family: var(--type-ui); }
  .dogma-popover header { display: flex; gap: .75rem; align-items: start; justify-content: space-between; }
  .dogma-popover h3 { font-family: var(--type-display); font-size: 1.6rem; line-height: 1.1; overflow-wrap: anywhere; }
  .dogma-close { display: grid; place-items: center; width: 2rem; height: 2rem; flex-shrink: 0; margin: -.35rem -.35rem 0 0; font-size: 1.5rem; cursor: pointer; }
  .dogma-popover[data-preview] .dogma-close { visibility: hidden; }
  .dogma-level { display: flex; gap: .4rem; align-items: center; margin-block: .7rem; color: var(--text-muted); font-size: .65rem; }
  .dogma-description { font-size: .85rem; line-height: 1.55; overflow-wrap: anywhere; }
  .dogma-source { display: inline-block; margin-top: .8rem; color: var(--accent); font-size: .75rem; text-decoration: underline; text-underline-offset: .2em; }
  @media (pointer: coarse) { .dogma-trigger { min-height: 2.75rem; } .dogma-close { width: 2.75rem; height: 2.75rem; } }
</style>
