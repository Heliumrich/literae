---
import BaseLayout from "../layouts/BaseLayout.astro";
import Fleur from "../components/Fleur.astro";
import { ART_BASE } from "../lib/site-links";

export const prerender = true;

const gestures = [
  {
    number: "I",
    title: "Lire",
    text: "Découvrir les ouvrages de la tradition chrétienne et comparer les traductions de l’Écriture.",
    href: "/scriptorium",
  },
  {
    number: "II",
    title: "Contempler",
    text: "Présenter l’art chrétien comme une exposition reliée aux artistes, aux figures et à leur histoire.",
    href: `${ART_BASE}/`,
  },
  {
    number: "III",
    title: "Prier",
    text: "Rassembler des prières en français et en latin dans une forme propice à la lecture et à la mémorisation.",
    href: "/prieres",
  },
];
---

<BaseLayout
  title="À propos"
  description="Literae est un atelier catholique francophone consacré à la lecture de l’Écriture, à l’art chrétien et à la prière."
>
  <main>
    <section class="about-hero">
      <div class="page-wrap about-hero-grid">
        <div>
          <p class="eyebrow">À propos</p>
          <h1>Un atelier pour lire, contempler et prier.</h1>
          <p class="about-lead">
            Literae est un projet catholique francophone indépendant, consacré à la
            transmission du patrimoine chrétien. Sa bibliothèque, sa galerie d’art
            et ses ressources de prière invitent à le découvrir et à l’approfondir.
          </p>
        </div>
        <aside class="motto" aria-label="Devise de Literae">
          <Fleur class="motto-fleur" />
          <blockquote>
            <p lang="la">Tolle, lege.</p>
            <footer>Prends et lis.</footer>
          </blockquote>
        </aside>
      </div>
    </section>

    <section class="gesture-section" aria-labelledby="gestures-title">
      <div class="page-wrap">
        <header class="gesture-heading">
          <p class="eyebrow">Trois gestes</p>
          <h2 id="gestures-title">Découvrir le patrimoine chrétien.</h2>
        </header>
        <div class="gesture-register">
          {gestures.map((gesture) => (
            <article>
              <p class="gesture-number" aria-hidden="true">{gesture.number}</p>
              <div>
                <h3>{gesture.title}</h3>
                <p>{gesture.text}</p>
                <a href={gesture.href} class="editorial-link">
                  Entrer <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="page-wrap rights-section" aria-labelledby="rights-title">
      <h2 id="rights-title">Droits d’auteur</h2>
      <p>
        Nous mettons tout en œuvre pour vérifier les droits de chaque image de la
        galerie d’art et de chaque ouvrage de la bibliothèque. Si vous constatez
        un problème concernant ces droits, merci de nous contacter à&nbsp;<a href="mailto:contact@literae.ch">contact@literae.ch</a>.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .about-hero {
    border-bottom: 1px solid var(--border);
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.55fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: start;
    padding-top: var(--page-start);
    padding-bottom: var(--intro-end);
  }

  .about-hero h1 {
    margin-top: 1rem;
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    line-height: 1.08;
  }

  .about-lead {
    max-width: 43rem;
    margin-top: 2rem;
    color: var(--text-muted);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
  }

  .motto {
    display: grid;
    min-height: 22rem;
    place-items: center;
    align-content: center;
    border: 1px solid var(--border);
    color: var(--text-muted);
    text-align: center;
  }

  .motto :global(.motto-fleur) {
    width: 3.5rem;
    color: var(--gold);
    opacity: 0.7;
  }

  .motto blockquote {
    margin-top: 1.5rem;
  }

  .motto blockquote p {
    font-family: var(--type-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-style: italic;
  }

  .motto blockquote footer {
    margin-top: 0.35rem;
    color: var(--text-subtle);
    font-family: var(--type-ui);
    font-size: 0.67rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gesture-heading h2,
  .rights-section h2 {
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.15;
  }

  .gesture-section {
    padding: clamp(5rem, 9vw, 8rem) 0;
    border-block: 1px solid var(--border);
    background: color-mix(in oklab, var(--card) 52%, var(--bg));
  }

  .gesture-heading {
    padding-bottom: 2rem;
  }

  .gesture-heading h2 {
    margin-top: .75rem;
  }

  .gesture-register {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--text);
  }

  .gesture-register article {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.7rem;
    padding: 2rem 1.8rem 0 0;
  }

  .gesture-register article + article {
    padding-left: 1.8rem;
    border-left: 1px solid var(--border);
  }

  .gesture-number {
    color: var(--gold);
    font-family: var(--type-ui);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .gesture-register h3 {
    font-family: var(--type-display);
    font-size: clamp(2rem, 3.2vw, 3rem);
    line-height: 1;
  }

  .gesture-register h3 + p {
    min-height: 8rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .gesture-register .editorial-link {
    margin-top: 1rem;
  }

  .rights-section {
    padding-top: clamp(5rem, 9vw, 8rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .rights-section p {
    max-width: 48rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
  }

  .rights-section a { color: var(--accent); text-decoration: underline; }

  @media (max-width: 780px) {
    .about-hero-grid {
      grid-template-columns: 1fr;
    }

    .motto {
      width: min(100%, 26rem);
      min-height: 18rem;
    }

    .gesture-register {
      grid-template-columns: 1fr;
    }

    .gesture-register article,
    .gesture-register article + article {
      padding: 1.6rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--border);
    }

    .gesture-register h3 + p {
      min-height: 0;
    }
  }
</style>
