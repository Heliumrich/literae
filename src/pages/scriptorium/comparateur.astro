---
import ComparatorAppChrome from "../../components/bible/ComparatorAppChrome.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getOfflineBible } from "../../lib/offline/bible-build";
import Comparator from "../../components/bible/Comparator.svelte";
import { getBibleTranslations, getBibleNavigationBooks } from "../../lib/bible-server";

export const prerender = true;

const offlineBible = getOfflineBible();
const translations = getBibleTranslations();
const navigationBooks = getBibleNavigationBooks();
---

<BaseLayout
  title="Comparateur"
  description="Collationner les versions françaises de la Sainte Écriture – Crampon, Fillion, Sacy, Segond, Ostervald, Vulgate."
>
  <Fragment slot="head">
    <script is:inline>
      // Only this page has an installed-app shell. Run before paint on iOS too.
      const displayMode = window.matchMedia('(display-mode: standalone)');
      const renderAppMode = () => {
        document.documentElement.dataset.comparatorMode = displayMode.matches || navigator.standalone ? 'standalone' : 'browser';
      };
      renderAppMode();
      displayMode.addEventListener('change', renderAppMode);
    </script>
    <link rel="manifest" href="/scriptorium/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/scriptorium/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Literae" />
  </Fragment>
  <ComparatorAppChrome slot="app-header" position="header" />
  <ComparatorAppChrome slot="app-footer" position="footer" />
  <main>
    <div class="page-wrap comparator-wrap">
      <header class="page-intro">
        <p class="eyebrow">Lire · Les Saintes Écritures</p>
        <h1 class="mt-3">Le comparateur</h1>
        <p class="mt-6">
          Ouvrez plusieurs traductions sur un même pupitre et laissez leurs nuances
          éclairer le texte, verset après verset.
        </p>
      </header>
      <Comparator client:only="svelte" offlineBible={offlineBible} initialTranslations={translations} initialNavigationBooks={navigationBooks} />
    </div>
    <div class="comparator-bottom-space h-20 sm:h-28"></div>
  </main>
</BaseLayout>

<style>
  .comparator-wrap {
    width: min(100% - clamp(2rem, 4vw, 6rem), 120rem);
  }

  @media (max-width: 1000px), (pointer: coarse) and (max-height: 600px) {
    .comparator-wrap {
      width: calc(100% - 0.75rem);
    }

    .page-intro {
      padding-inline: 0.4rem;
    }
  }
</style>
