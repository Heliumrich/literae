---
import BookCatalog from '../../../../../components/books/BookCatalog.astro';
import { BOOK_ORDERS } from '../../../../../lib/books';
import { fetchBooks } from '../../../../../lib/books-server';
import { PAGE_SIZE } from '../../../../../lib/catalog';
export const prerender = true;

export async function getStaticPaths() {
  return (await Promise.all(BOOK_ORDERS.map(async order => {
    const books = await fetchBooks(order);
    const pages = Math.ceil(books.length / PAGE_SIZE);
    return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => ({
      params: { order, page: String(i + 2) },
      props: { books, currentPage: i + 2, order },
    }));
  }))).flat();
}
const { books, currentPage, order } = Astro.props;
---
<BookCatalog books={books} currentPage={currentPage} order={order} />
