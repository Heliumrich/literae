---
import { fetchZoomArtworks } from "../../../lib/artworks-server";

export const prerender = true;

export async function getStaticPaths() {
  const works = await fetchZoomArtworks('id,slug');
  return works
    .filter((work) => work?.slug)
    .map((work) => ({ params: { slug: String(work.slug) } }));
}

return Astro.redirect(`/oeuvres/${Astro.params.slug ?? ""}`, 301);
---
