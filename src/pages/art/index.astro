---
import ArtSelection from "../../components/ArtSelection.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArtworkCard from "../../components/ArtworkCard.astro";
import Fleur from "../../components/Fleur.astro";
import Cross from "../../components/Cross.astro";
import { artworkHeroImage, GALLERY_FEATURED_ARTWORK_SLUG } from '../../lib/art-media';
import { fetchArtworkCatalog, selectFeaturedArtwork } from '../../lib/artworks-server';
import {
  fetchArtistsList,
  getArtworkTitle,
} from "../../lib/directus";

const people = await fetchArtistsList();
const artworks = await fetchArtworkCatalog();
const featured = selectFeaturedArtwork(artworks, GALLERY_FEATURED_ARTWORK_SLUG);
const latest = artworks.slice(0, 8);
const featuredImage = artworkHeroImage(featured);
const heroSizes = [
  '(orientation: portrait) and (max-width: 800px) 100vw',
  '(orientation: landscape) and (max-width: 700px) and (max-height: 600px) calc(40vw + 3px)',
  '(min-width: 1248px) calc(50vw + 49px)',
  'max(336px, calc(54vw - 1px))',
].join(', ');
---

<BaseLayout gallery title="Contempler" description="Le cabinet d’art chrétien de Literae">
  <main>
    <section class="art-hero">
      <div class="page-wrap art-hero-grid">
        <div class="art-hero-copy">
          <p class="eyebrow art-eyebrow"><Cross kind="malte" /> Contempler · Le cabinet d’images</p>
          <h1>Le beau comme seuil du mystère.</h1>
          <p>
            Une collection d’œuvres chrétiennes à regarder lentement, accompagnées
            de leurs artistes, de leur histoire et des figures qu’elles représentent.
          </p>
          <a href="/oeuvres" class="editorial-button">Parcourir les œuvres <span aria-hidden="true">→</span></a>
        </div>

        <div class="art-hero-image">
          {
            featuredImage && featured ? (
              <a href={`/oeuvres/${featured.slug}`}>
                <img
                  src={featuredImage.src}
                  srcset={featuredImage.srcset}
                  sizes={featuredImage.srcset ? heroSizes : undefined}
                  alt={getArtworkTitle(featured)}
                  width={featuredImage.width ?? 800}
                  height={featuredImage.height ?? 980}
                  loading="eager"
                  fetchpriority="high"
                />
                <span>
                  {getArtworkTitle(featured)}
                  {featured.year ? ` · ${featured.year}` : ""}
                </span>
              </a>
            ) : (
              <Fleur class="text-gold" />
            )
          }
        </div>
      </div>
    </section>

    <ArtSelection />

    {
      latest.length > 0 && (
        <section class="art-latest" aria-labelledby="latest-title">
          <div class="page-wrap">
            <div class="art-section-head">
              <div>
                <p class="eyebrow">Nouveaux regards</p>
                <h2 id="latest-title">Dernières œuvres déposées</h2>
              </div>
              <a href="/oeuvres/nouveautes" class="editorial-link">Voir les derniers ajouts →</a>
            </div>
            <div class="catalog-grid">
              {latest.map((work, index) => <ArtworkCard work={work} index={index} />)}
            </div>
          </div>
        </section>
      )
    }
    <section class="page-wrap art-gateways" aria-label="Explorer le cabinet">
      <a href="/oeuvres">
        <p class="eyebrow">La collection</p>
        <h2>Œuvres</h2>
        <p>Tableaux, fresques et sculptures</p>
        <span>{artworks.length} <small>{artworks.length > 1 ? "œuvres" : "œuvre"}</small></span>
      </a>
      <a href="/personalites">
        <p class="eyebrow">Les vies</p>
        <h2>Personnalités</h2>
        <p>Artistes, saints, souverains et écrivains</p>
        <span>{people.length} <small>{people.length > 1 ? "notices" : "notice"}</small></span>
      </a>
    </section>

  </main>
</BaseLayout>

<style>
  .art-hero {
    border-bottom: 1px solid var(--border);
  }

  .art-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(20rem, 1.08fr);
    align-items: stretch;
    min-height: calc(100dvh - var(--site-header-height) - 1px);
  }

  .art-hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1rem, 5dvh, 4rem) clamp(1.5rem, 4vw, 4rem) clamp(1rem, 5dvh, 4rem) 0;
  }

  .art-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .art-hero h1 {
    margin-top: 1rem;
    font-size: clamp(2rem, min(7vw, 9dvh), 6.8rem);
  }

  .art-hero-copy > p:not(.eyebrow) {
    max-width: 32rem;
    margin-top: clamp(.75rem, 2dvh, 2rem);
    color: var(--text-muted);
    font-size: clamp(.9rem, 1.7dvh, 1.16rem);
  }

  .art-hero-copy .editorial-button {
    align-self: flex-start;
    margin-top: clamp(.75rem, 2dvh, 2.2rem);
  }

  .art-hero-image {
    position: relative;
    display: grid;
    min-height: 0;
    margin-right: calc((100vw - min(100vw - 2rem, 76rem)) / -2);
    place-items: center;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .art-hero-image > a {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .art-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: saturate(0.86);
  }

  .art-hero-image > :global(svg) {
    width: 7rem;
    opacity: 0.45;
  }

  .art-hero-image span {
    position: absolute;
    right: 1.5rem;
    bottom: 1.4rem;
    left: 1.5rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(255, 250, 240, 0.65);
    color: #fffaf0;
    font-family: var(--type-ui);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.8);
  }

  .art-gateways {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
  }

  .art-gateways > a {
    position: relative;
    padding: 2.5rem 3rem 2.5rem 0;
    border-block: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
  }

  .art-gateways > a + a {
    padding-right: 0;
    padding-left: 3rem;
    border-left: 1px solid var(--border);
  }

  .art-gateways h2 {
    margin-top: 0.5rem;
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    line-height: 0.9;
  }

  .art-gateways a > p:not(.eyebrow) {
    margin-top: 0.9rem;
    color: var(--text-muted);
  }

  .art-gateways a > span {
    position: absolute;
    top: 2.2rem;
    right: 2.2rem;
    color: var(--gold);
    font-family: var(--type-display);
    font-size: 2.1rem;
  }

  .art-gateways small {
    font-family: var(--type-ui);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .art-latest {
    padding: clamp(4rem, 8vw, 7rem) 0;
    border-top: 1px solid var(--border);
    background: color-mix(in oklab, var(--card) 50%, var(--bg));
  }

  .art-section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .art-section-head h2 {
    margin-top: 0.6rem;
    font-size: clamp(2.6rem, 5vw, 4.5rem);
    line-height: 0.95;
  }

  @media (max-width: 800px) and (orientation: portrait) {
    .art-hero-grid {
      width: 100%;
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(10rem, 1fr);
    }

    .art-hero-copy {
      width: min(100% - 2rem, 46rem);
      margin-inline: auto;
      padding: 1.25rem 0;
    }

    .art-hero h1 { font-size: clamp(2.4rem, 11vw, 3.2rem); }
    .art-hero-copy > p:not(.eyebrow) { font-size: 1rem; }

    .art-hero-image {
      min-height: 10rem;
      margin: 0;
    }
  }

  @media (max-width: 600px) {
    .art-gateways {
      grid-template-columns: 1fr;
    }

    .art-gateways > a,
    .art-gateways > a + a {
      padding: 2rem 0;
      border-left: 0;
    }

    .art-gateways > a + a {
      border-top: 0;
    }

    .art-gateways a > span {
      top: 1.7rem;
      right: 0;
    }

    .art-section-head {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (orientation: landscape) and (max-height: 600px) {
    .art-hero-copy { padding-block: 1rem; }
    .art-hero h1 { margin-top: .5rem; }
  }

  @media (orientation: landscape) and (max-width: 700px) and (max-height: 600px) {
    .art-hero-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); }
    .art-hero-copy { padding: .25rem 1rem .25rem 0; }
    .art-hero h1 { font-size: clamp(1.5rem, 8dvh, 2rem); }
    .art-hero-copy > p:not(.eyebrow) { margin-top: .5rem; font-size: .85rem; line-height: 1.4; }
    .art-hero-copy .editorial-button { margin-top: .5rem; }
  }

  @media (orientation: landscape) and (max-width: 600px) {
    /* Match the narrower mobile .page-wrap gutter. */
    .art-hero-image { margin-right: -.625rem; }
  }
</style>
