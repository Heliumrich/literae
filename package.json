{
  "name": "literae",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier catholique francophone pour lire, contempler et prier.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "bible:sync": "node scripts/sync-bible.mjs",
    "prebuild": "npm run bible:sync",
    "build": "npm run check:static && astro build",
    "check": "npm run check:types && npm run check:static",
    "check:types": "astro sync && tsc --noEmit",
    "check:static": "node scripts/check-static-boundary.mjs",
    "preview": "astro preview",
    "start": "node dist/server/entry.mjs",
    "astro": "astro",
    "test:pwa": "playwright test",
    "test:server": "node --experimental-strip-types --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.4",
    "@astrojs/svelte": "^9.1.2",
    "@tailwindcss/vite": "4.3.3",
    "approve": "^0.0.12",
    "astro": "^7.4.4",
    "better-sqlite3": "13.0.3",
    "epubjs": "0.3.93",
    "es5-ext": "^0.10.64",
    "micromark": "4.0.2",
    "scripts": "^0.1.0",
    "sql.js": "1.15.0",
    "svelte": "5.57.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/sql.js": "1.4.11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "core-js@3.51.0": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.15.18": true,
    "svelte-preprocess@4.10.7": true
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.9.12"
    }
  }
}
